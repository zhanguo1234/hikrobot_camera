<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hikrobot_camera</name>
  <version>1.0.0</version>
  <description>ROS 2 Humble driver for HIKROBOT USB3/GigE industrial cameras,
    wrapping the HIKROBOT MVS SDK (image acquisition, pixel format conversion,
    runtime parameter control and automatic reconnection).</description>
  <maintainer email="749312902@qq.com">zhanguo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
